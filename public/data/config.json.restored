  "glossary": [
    {
      "term": "Dolby Atmos",
      "definition": "Immersive 3D audio technology that places sounds anywhere in a 3D space, creating a more realistic and enveloping sound experience compared to traditional surround sound systems."
    },
    {
      "term": "4K",
      "definition": "Ultra High Definition video resolution with approximately 4,000 pixels of horizontal resolution. Provides four times the detail of standard HD (1080p) and delivers sharper, more lifelike images."
    },
    {
      "term": "Laser",
      "definition": "Advanced projection technology using laser light sources instead of traditional lamps. Offers higher brightness (35,000-60,000 lumens), better color accuracy, and longer lifespan than traditional projectors."
    },
    {
      "term": "LED",
      "definition": "Direct-LED display technology where each pixel emits its own light. Provides exceptional brightness (1,200+ nits), perfect black levels, and infinite contrast ratio for stunning image quality."
    },
    {
      "term": "70mm",
      "definition": "Large-format film stock (70mm wide) used in premium cinemas. Offers superior image quality, higher resolution, and better color reproduction than standard 35mm film, though now mostly used in heritage cinemas."
    },
    {
      "term": "HDR",
      "definition": "Technology that expands the range of brightness levels and colors beyond traditional displays. Standards include HDR10, HDR10+, and Dolby Vision, providing more realistic contrast and color accuracy."
    },
    {
      "term": "HFR",
      "definition": "Playback at higher frame rates (48fps, 60fps, or higher) than standard cinema's 24fps. Reduces motion blur and creates smoother, more lifelike motion, especially beneficial for action sequences."
    },
    {
      "term": "PLF",
      "definition": "Modern cinema standard combining large screens (typically 40ft+ wide), advanced projection technology (laser/LED), immersive sound (Dolby Atmos), and premium seating for an enhanced movie-going experience."
    },
    {
      "term": "Aspect Ratio",
      "definition": "The proportional relationship between a screen's width and height. Modern cinemas use 1.90:1 (widescreen) or 2.39:1 (CinemaScope) ratios, compared to older 1.85:1 or 1.37:1 standards."
    },
    {
      "term": "Screen Gain",
      "definition": "Measure of how much a screen amplifies projected light. Higher gain screens (1.8) reflect more light toward the audience but have narrower viewing angles. Lower gain screens (1.2-1.7) provide more even brightness across the theater."
    },
    {
      "term": "Premium Large Format",
      "definition": "Modern cinema standard combining large screens (typically 40ft+ wide), advanced projection technology (laser/LED), immersive sound (Dolby Atmos), and premium seating for an enhanced movie-going experience."
    }
  ]
}
