vp check --no-fmt --fix
vp lint --type-aware
vp build
for page in index.html india.html seating.html sound.html; do
  if [ ! -f "dist/$page" ]; then echo "FAIL: dist/$page missing"; exit 1; fi
done
for html in dist/*.html; do
  for asset in $(grep -ohP '(href|src)="\K(/theater-tech/assets/[^"]+)' "$html"); do
    file="dist/${asset#/theater-tech/}"
    if [ ! -f "$file" ]; then echo "FAIL: $asset missing in $html"; exit 1; fi
  done
done
echo "All assets verified"
vp test
