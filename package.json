  "dependencies": {
    "d3": "^7.9.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "husky": "^9.1.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "latest"
  }
